# ── DIVINE SPIRIT API — copy to .env (never commit real values) ──
NODE_ENV=production
PORT=3000
# Telegram bot token from @BotFather (used ONLY server-side to verify initData)
BOT_TOKEN=
# >= 32 random chars: signs player/admin session tokens.  openssl rand -hex 32
SESSION_SECRET=
# MongoDB Atlas (or any replica set — transactions are REQUIRED in production)
MONGODB_URI=
DB_NAME=divinespirit
# Comma-separated exact origins of the Mini App frontend (and admin page if hosted separately)
ALLOWED_ORIGIN=https://your-miniapp.example.com
# Number of reverse-proxy hops in front of the API (Render/Heroku = 1)
TRUST_PROXY=1
# Admin accounts: JSON array. Hash with:  npm run hash-password -- 'long passphrase'
# roles: owner | finance | support | viewer
ADMIN_ACCOUNTS=[{"username":"owner","passwordHash":"scrypt$16384$...","role":"owner"}]
# Rewarded-ad provider secret (server-to-server callback auth). Leave empty to keep ads off.
ADS_SECRET=
# Optional: serve ./web from the API host (single-origin deploy, recommended for the admin page)
SERVE_WEB=0
# Optional tuning
INITDATA_MAX_AGE_SEC=3600
SESSION_TTL_SEC=43200
# Local development ONLY (refused when NODE_ENV=production): lets localhost log in without Telegram
DEV_AUTH_BYPASS=0
